ORNITH_GGUF_PATH=/absolute/path/to/ornith-9b-mtp-kl-Q8_0.gguf

# SWE task cases (e2e/swe_test.go, S..). The live SWE case uses
# INVOKR_E2E_SWE_MODEL if set, else INVOKR_E2E_LIVE_MODEL; with neither set it
# skips rather than scoring an unnamed default. INVOKR_E2E_SWE_TIMEOUT (default
# 10m) bounds one attempt.
# INVOKR_E2E_SWE_MODEL=
# INVOKR_E2E_SWE_TIMEOUT=10m
